# Merge the sections you use into ~/.env. Never commit actual credentials.
# Process environment variables take precedence. Override file with JIRA_ENV_FILE.
# AUTH_TYPE: bearer (Server/Data Center PAT) or basic (username + token).
# Confirm the authentication method with your Jira administrator.
# HTTP exposes tokens. Prefer an administrator-confirmed HTTPS URL.
# ALLOW_HTTP=true requires explicit acceptance of this risk on a trusted network.

# /osc — http://clm.lge.com/issue/projects/OSC
JIRA_CLM_OSC_URL=http://clm.lge.com/issue
JIRA_CLM_OSC_PROJECT_KEY=OSC
JIRA_CLM_OSC_AUTH_TYPE=bearer
JIRA_CLM_OSC_TOKEN=replace_with_your_clm_osc_token
JIRA_CLM_OSC_USERNAME=
JIRA_CLM_OSC_ALLOW_HTTP=false

# /osct — http://clm.lge.com/issue/projects/OSCT/
JIRA_CLM_OSCT_URL=http://clm.lge.com/issue
JIRA_CLM_OSCT_PROJECT_KEY=OSCT
JIRA_CLM_OSCT_AUTH_TYPE=bearer
JIRA_CLM_OSCT_TOKEN=replace_with_your_clm_osct_token
JIRA_CLM_OSCT_USERNAME=
JIRA_CLM_OSCT_ALLOW_HTTP=false

# /harmony — https://harmony.lge.com:8443/issue/browse/OSC
JIRA_HARMONY_OSC_URL=https://harmony.lge.com:8443/issue
JIRA_HARMONY_OSC_PROJECT_KEY=OSC
JIRA_HARMONY_OSC_AUTH_TYPE=bearer
JIRA_HARMONY_OSC_TOKEN=replace_with_your_harmony_osc_token
JIRA_HARMONY_OSC_USERNAME=
JIRA_HARMONY_OSC_ALLOW_HTTP=false